# 复制为 .env 并填入真实账号(uv run 会自动读取 .env)
SDYXY_ID_CARD=你的身份证号
SDYXY_PASSWORD=你的密码
# 可选: 登录页完整 URL(默认已内置该站登录路由, 无需填写)
# SDYXY_LOGIN_URL=http://sdyxy.wx.superchutou.com/pages/login/index
# 可选: 1=无头模式(定时任务建议), 默认 0=有头
# SDYXY_HEADLESS=1
# 可选: 换目标站点(注意该站只有 http, https 443 是 404)
# SDYXY_BASE_URL=http://sdyxy.wx.superchutou.com
# 可选: 单次模式等房间最长秒数(默认 3600)
# SDYXY_ROOM_WAIT_S=3600
# 可选: 课后宽限秒数(默认 600)
# SDYXY_ROOM_GRACE_S=600
# 可选: 调度器测试模式(15 秒后触发, 窗口 3 分钟)
# SDYXY_SCHEDULE_TEST=1
